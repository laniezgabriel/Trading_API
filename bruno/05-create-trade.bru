meta {
  name: Create trade
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/trades
  body: json
  auth: none
}

body:json {
  {
    "instrument": "XAUUSD",
    "direction": "BUY",
    "profitLoss": -450,
    "accountId": {{accountId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("tradeId", res.body.id);
}
